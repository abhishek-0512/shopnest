# Server Configuration
PORT=8000
NODE_ENV=production

# MongoDB Database Connection String (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopnest?retryWrites=true&w=majority

# JSON Web Token Secret for Authentication
JWT_SECRET=shopnest_jwt_super_secret_key_2025_change_in_production

# Frontend Client URL for CORS
CLIENT_URL=https://shopnest-tau-pink.vercel.app

# Razorpay Payment Gateway Credentials (Get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Credentials for Product Image Uploads (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service Credentials for Order Receipts via Nodemailer (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
